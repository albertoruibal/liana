{
  "name": "liana",
  "description": "Minimal git GUI: commit graph with commit / rebase / cherry-pick / revert, push / pull / login",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "author": "Liana",
  "desktopName": "dev.liana.app",
  "homepage": "https://example.com/liana",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fixture": "bash scripts/make-fixture-repo.sh test-repo",
    "fixture:conflict": "bash scripts/make-conflict-fixture.sh test-repo-conflict",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "electron:compile": "node scripts/build-electron.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && npm run typecheck && npm run electron:compile",
    "electron:dist": "npm run electron:build && electron-builder --linux --publish never",
    "electron:dist:linux": "npm run electron:build && electron-builder --linux --publish never",
    "electron:dist:win": "npm run electron:build && electron-builder --win --publish never",
    "electron:dist:mac": "npm run electron:build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lit": "^3.3.3",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
